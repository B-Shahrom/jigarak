Windows Registry Editor Version 5.00

; Запрет Панели управления и настроек
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer]
"NoControlPanel"=dword:00000001

; Запрет Settings (частично работает в Win10/11)
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer]
"SettingsPageVisibility"="hide:all"

; Запрет запуска системных инструментов прокси/сети через UI
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Policies\Network]
"NC_LanChangeProperties"=dword:00000001

; Отключение доступа к Internet Options (частично влияет на прокси)
[HKEY_CURRENT_USER\Software\Policies\Microsoft\Internet Explorer\Control Panel]
"Proxy"=dword:00000001

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Internet Settings]
"ProxyEnable"=dword:00000001
"ProxyServer"="127.0.0.1:8080"
"ProxyOverride"="electicode.com;cdn.jsdelivr.net"